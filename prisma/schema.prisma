generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================
// TENANT (Boutique)
// =====================
model Tenant {
  id                  String   @id @default(cuid())
  slug                String   @unique
  customDomain        String?  @unique
  domaineActifAt      DateTime? // domaine personnalisé confirmé actif par Vercel (propriété + DNS) : il devient l'adresse principale de la boutique
  nomBoutique         String
  description         String?
  categorie           String
  pays                String
  devise              String   @default("XAF")
  whatsapp            String
  whatsappNumero      String?  // Numéro WhatsApp marchand pour commandes physiques ex: "+22507XXXXXXXX"
  email               String
  telephone           String?
  adresse             String?
  logoUrl             String?
  bannerUrl           String?
  themeId             String   @default("terre-et-or")
  themeConfig         Json     @default("{}")
  commissionRate      Float    @default(0.1)
  statut              String   @default("active")
  planType            String   @default("gratuit")
  planExpiresAt       DateTime?
  planPendingRef      String?
  metaTitle           String?
  metaDescription     String?
  socialLinks         Json     @default("{}")
  parametresPaiement  Json     @default("{}")
  parametresLivraison Json     @default("{}")
  tauxTVA             Float    @default(0)
  juridiction         String   @default("CM") // code pays ISO pour TVA
  kycStatut           String   @default("non_soumis") // non_soumis | en_cours | valide | rejete
  kycDocUrl           String?
  certifie            Boolean  @default(false)
  editionIaBloquee    Boolean  @default(false) // verrou d'urgence : aucune IA externe ne modifie la boutique (lib/builder)
  snapActif             Boolean  @default(false)
  parametresAffiliation Json?    @default("{}")
  parametresCommande    Json     @default("{}") // formulaire "Commander maintenant" : champs actifs/personnalisés
  metaPixelId           String? // Meta Pixel ID du marchand, injecté sur la vitrine
  tiktokPixelId         String? // TikTok Pixel ID, injecté sur la vitrine
  snapPixelId           String? // Snapchat Pixel ID, injecté sur la vitrine
  gtmId                 String? // Google Tag Manager container ID (GTM-XXXXXXX), injecté sur la vitrine
  trackingScripts       String?  @db.Text // Scripts de suivi personnalisés du marchand, injectés tels quels sur sa propre vitrine
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  produits               Produit[]
  collections            Collection[]
  categoriesProduits     CategorieProduit[]
  commandes              Commande[]
  clients                Client[]
  commissions            Commission[]
  codesPromo             CodePromo[]
  avis                   Avis[]
  membres                MembreEquipe[]
  proprietaires          ProprietaireBoutique[]
  analytics              Analytics[]
  livreurs               Livreur[]
  themes                 Theme[]
  wallet                 Wallet?
  postsSociaux           PostSocial[]
  affiliationLiens       AffiliationLien[]
  entrepots              Entrepot[]
  affiliationsEntrantes  AffiliationEntrante[]
  paiementsCommissions   PaiementCommission[]
  commandesFournisseur   CommandeFournisseur[]
  programmeAffiliation   ProgrammeAffiliation?
  affilies               Affilie[]
  commissionsAffilie     CommissionAffilie[]
  notificationsMarchand  NotificationMarchand[]
  stockMouvements        StockMouvement[]
  lotsTracabilite        LotTracabilite[]
  chargesExploitation    ChargeExploitation[]
}

// =====================
// PRODUIT
// =====================
model Produit {
  id              String   @id @default(cuid())
  tenantId        String
  nom             String
  slug            String
  description     String?
  descriptionIA   String?
  prix            Float
  prixCompare     Float?
  cout            Float?
  stock           Int      @default(0)
  sku             String?
  codeBarres      String?  // EAN/UPC — utilisé par le scanner de la Caisse POS
  images          String[]
  videos          String[] // URLs vidéos produit (Vercel Blob)
  categorie       String?
  tags            String[]
  poids           Float?
  actif           Boolean  @default(true)
  featured        Boolean  @default(false)
  metaTitle       String?
  metaDesc        String?
  ogImage         String?   // Image Open Graph dédiée (sinon images[0])
  masquerVentes   Boolean   @default(false)  // Masquer le compteur de ventes sur la boutique
  visibleListage  Boolean   @default(true)   // false = masqué du catalogue, URL directe OK
  texteBoutonAchat String?  // Texte personnalisé du bouton d'achat (défaut "Acheter")
  faq             Json?     // [{ question: String, reponse: String }]
  champsCommande  Json?     // [{ label: String, type: texte|email|telephone|choix, requis: Boolean, options?: String[] }]
  ventes          Int      @default(0)
  vues            Int      @default(0)
  // Type de produit
  type            String   @default("physique") // physique | digital | dropshipping
  // Produit digital
  fichierUrl      String?  // URL du fichier téléchargeable (Vercel Blob)
  fichierNom      String?  // Nom du fichier affiché
  fichierTaille   Int?     // Taille en octets
  instructionsTelechargement String?
  // Chariow (paiement digital via API Chariow)
  chariowProduitId  String?  // ID du produit correspondant sur chariow.com (ex: prd_abc123)
  // Affiliation
  affiliationActive   Boolean @default(true)
  tauxCommissionAff   Float?  // ex: 0.20 = 20% pour l'affilieur (sur le prix HT commission Axso)
  // Dropshipping
  prixFournisseur Float?   // Prix d'achat fournisseur
  urlFournisseur  String?  // URL source produit fournisseur
  nomFournisseur  String?  // Nom du fournisseur
  fournisseurId   String?  // FK vers Fournisseur
  // Stock
  stockMin        Int?     // seuil de réapprovisionnement (alerte AXIA)
  stockReserve    Int      @default(0) // stock réservé par paniers actifs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  fournisseur     Fournisseur?     @relation(fields: [fournisseurId], references: [id])
  variantes       Variante[]
  collections     Collection[]     @relation("ProduitCollection")
  lignesCommande  LigneCommande[]
  avis            Avis[]
  wishlist        Wishlist[]
  telechargements Telechargement[]
  accesFormations AccesFormation[]
  affiliationLiens AffiliationLien[]
  stocksEntrepot  StockEntrepot[]
  stockMouvements StockMouvement[]
  lotsTracabilite LotTracabilite[]
  // Produits digitaux avancés
  variantesPrix   VariantePrix[]
  produitFichier  ProduitFichier?
  formation       Formation?
  licenceProduit  LicenceProduit?
  bundleProduit   BundleProduit?
  inclusEnBundle  ElementBundle[]  @relation("InclusDansBundle")
  offresFournisseurs ProduitFournisseur[] // Supplier Intelligence : offres comparées pour ce produit

  // POS 2.0
  // Unité de vente : "piece" (défaut) ou "kg". Pour "kg" : `stock`, StockEntrepot.quantite
  // et LigneCommande.quantite sont tenus en GRAMMES (entiers) et `prix` / `cout`
  // sont au KILO. Convention détaillée dans lib/pos/tarification.ts.
  uniteVente      String   @default("piece")
  tauxTVA         Float?   // fraction propre au produit (0.1925) ; null = taux de la boutique (Tenant.tauxTVA)
  marque          String?
  suiviSerie      Boolean  @default(false) // chaque unité porte un numéro de série / IMEI (NumeroSerie)
  garantieMois    Int?
  numerosSerie       NumeroSerie[]
  lignesComptage     LigneComptage[]
  lignesTransfert    LigneTransfert[]
  lignesBonCommande  LigneBonCommande[]
  lignesReception    LigneReception[]

  @@unique([tenantId, slug])
  @@unique([tenantId, codeBarres])
}

// =====================
// TÉLÉCHARGEMENT (produits digitaux)
// =====================
model Telechargement {
  id         String   @id @default(cuid())
  produitId  String
  commandeId String
  token      String   @unique
  expireAt   DateTime? // null = accès à vie (tant que la commande est payée) ; date passée = lien révoqué par le marchand
  telecharge Boolean  @default(false)
  createdAt  DateTime @default(now())

  produit  Produit  @relation(fields: [produitId], references: [id])
}

// =====================
// VARIANTE PRODUIT
// =====================
model Variante {
  id        String  @id @default(cuid())
  produitId String
  nom       String
  valeur    String
  prix      Float?
  stock     Int     @default(0)
  sku       String?
  codeBarres String?
  image     String?
  actif     Boolean @default(true)
  dimension String? // ex: "XL / Rouge / Coton"

  produit Produit         @relation(fields: [produitId], references: [id])
  stocks  StockEntrepot[]

  cout      Float?  // POS 2.0 — coût d'achat propre à la variante (sinon Produit.cout)

  @@index([codeBarres])
  @@index([produitId])
}

// =====================
// COLLECTION
// =====================
model Collection {
  id          String   @id @default(cuid())
  tenantId    String
  nom         String
  slug        String
  description String?
  imageUrl    String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  produits Produit[] @relation("ProduitCollection")

  @@index([tenantId])
}

// =====================
// CLIENT
// =====================
model Client {
  id             String   @id @default(cuid())
  tenantId       String
  nom            String
  email          String? // facultatif (commande par téléphone) — plusieurs NULL autorisés par l'unique
  telephone      String?
  adresse        String?
  ville          String?
  pays           String?
  totalCommandes Int      @default(0)
  totalDepense   Float    @default(0)
  createdAt      DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  commandes Commande[]
  avis      Avis[]
  wishlist  Wishlist[]

  // POS 2.0 — fidélité, crédit, segmentation
  codeClient          String? // code / QR de la carte client ; unicité par boutique assurée par l'application (lib/pos)
  segment             String?
  pointsFidelite      Int     @default(0)
  niveauFidelite      String  @default("bronze") // bronze | silver | gold | vip
  creditPlafond       Float   @default(0)
  creditUtilise       Float   @default(0)
  creditBloque        Boolean @default(false)
  creditEcheanceJours Int?

  @@unique([tenantId, email])
  @@index([tenantId, telephone])
  @@index([tenantId, codeClient])
}

// =====================
// COMMANDE
// =====================
model Commande {
  id               String   @id @default(cuid())
  numero           String   @unique
  tenantId         String
  clientId         String?
  livreurId        String?
  clientNom        String
  clientEmail      String?
  clientTelephone  String
  adresseLivraison String
  ville            String
  pays             String
  montantSousTotal Float
  montantLivraison Float    @default(0)
  montantReduction Float    @default(0)
  montantTotal     Float
  devise           String   @default("XAF")
  statut           String   @default("en_attente")
  paiementStatut   String   @default("pending")
  methodePaiement  String
  flutterwaveRef   String?
  stripePaymentIntentId String?
  stripeChargeId   String?
  paiementProvider   String?
  paiementReference  String?
  codeAffiliation  String?  // code du lien d'affiliation utilisé
  affilieurId      String?  // tenantId de l'affilieur
  codePromoId      String?
  noteClient       String?
  numeroSuivi      String?
  transporteur     String?
  livraisonStatut  String   @default("non_expediee")
  // Localisation client
  latitudeClient   Float?
  longitudeClient  Float?
  adresseExacte    String?
  mapsLienClient   String?
  // Tracking livraison
  trackingToken    String?  @unique
  livreurToken     String?  @unique
  livreurPosition  Json?
  expedieeAt       DateTime? // départ de la tentative de livraison en cours (passage à "expediee")
  livreeAt         DateTime? // passage à "livree" — updatedAt bouge encore ensuite (remise COD, réception)
  codeLivraison    String?   // 4 chiffres envoyés au client au départ, exigés du livreur pour marquer "livree"
  codeEssais       Int       @default(0) // codes faux saisis par le livreur ; bloqué à 5, le marchand confirme alors lui-même
  livreurNom       String?
  livreurTelephone String?
  // Échec de livraison / replanification
  echecRaison      String?
  echecCount       Int      @default(0)
  // Réconciliation cash COD
  codRemis         Boolean  @default(false)
  codRemisAt       DateTime?
  codRemisParId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  client     Client?         @relation(fields: [clientId], references: [id])
  livreur    Livreur?        @relation(fields: [livreurId], references: [id])
  lignes     LigneCommande[]
  commission Commission?
  codePromo  CodePromo?      @relation(fields: [codePromoId], references: [id])
  affiliationCommission AffiliationCommission?
  retours              RetourRMA[]
  facture              Facture?
  commandesFournisseur CommandeFournisseur[]

  // POS 2.0 — vente en caisse (canal = "pos") : lieu, caisse, vendeur, taxes, encaissé.
  canal             String    @default("en_ligne") // en_ligne | pos
  magasinId         String?
  caisseId          String?
  sessionCaisseId   String?
  vendeurId         String?   // userId du caissier
  appareilId        String?
  montantTaxes      Float     @default(0) // TVA comprise dans montantTotal (ou ajoutée, selon ReglagesPos.reglages.taxes.prixTTC)
  montantPaye       Float     @default(0) // réellement encaissé, hors crédit client (une vente à crédit compte dans le CA dès la vente)
  creeLocalAt       DateTime? // horodatage de l'appareil (vente saisie hors ligne)
  commandeOrigineId String?   // échange / retour : vente d'origine
  paiements         PaiementVente[]

  @@index([tenantId, createdAt])
  @@index([tenantId, canal, createdAt])
  @@index([sessionCaisseId])
  @@index([clientId])
  @@index([livreurId])
}

// =====================
// LIGNE DE COMMANDE
// =====================
model LigneCommande {
  id         String  @id @default(cuid())
  commandeId String
  produitId  String
  nom        String
  prix       Float
  quantite   Int
  imageUrl   String?
  variante   String?
  lotId      String? // lot de traçabilité consommé pour cette ligne (FIFO), si le produit en utilise

  commande Commande        @relation(fields: [commandeId], references: [id])
  produit  Produit         @relation(fields: [produitId], references: [id])
  lot      LotTracabilite? @relation(fields: [lotId], references: [id])

  // POS 2.0
  varianteId        String?
  cout              Float?   // coût unitaire au moment de la vente (marge figée)
  remise            Float    @default(0) // remise totale de la ligne (manuelle + promotion + part de la remise globale)
  tauxTVA           Float?   // fraction (0.1925 = 19,25 %)
  prixOrigine       Float?   // prix catalogue quand un prix personnalisé a été saisi
  offert            Boolean  @default(false)
  commentaire       String?
  promotionId       String?
  quantiteRetournee Int      @default(0)
  // Produit au poids (Produit.uniteVente = "kg") : `quantite` est en GRAMMES, `prix`
  // est le prix au GRAMME (prix*quantite reste le montant de la ligne partout
  // ailleurs), `mesure` le poids en kilos pour l'affichage.
  mesure            Float?
  numeroSerieId     String?

  @@index([commandeId])
  @@index([produitId])
}

// =====================
// LIVREUR
// =====================
model Livreur {
  id           String   @id @default(cuid())
  userId       String   @unique
  tenantId     String?
  nom          String
  telephone    String
  vehicule     String   @default("moto")
  zone         String?
  disponible   Boolean  @default(true)
  actif        Boolean  @default(true)
  latitude     Float?
  longitude    Float?
  positionAt   DateTime?
  valideAt     DateTime? // null + inactif = en attente de validation ; renseigné + inactif = suspendu
  createdAt    DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  commandes     Commande[]
  notifications Notification[]
}

// =====================
// NOTIFICATION LIVREUR
// =====================
model Notification {
  id         String   @id @default(cuid())
  livreurId  String
  type       String
  titre      String
  message    String
  commandeId String?
  lu         Boolean  @default(false)
  createdAt  DateTime @default(now())

  livreur Livreur @relation(fields: [livreurId], references: [id])

  @@index([livreurId, createdAt])
}

// =====================
// NOTIFICATION MARCHAND (dashboard)
// =====================
model NotificationMarchand {
  id         String   @id @default(cuid())
  tenantId   String
  type       String // nouvelle_commande | commande_whatsapp | escalade_humain | stock_bas | avis | ...
  titre      String
  message    String
  lien       String? // deep-link dashboard, ex: /dashboard/commandes/xxx
  commandeId String?
  lu         Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, lu])
  @@index([tenantId, createdAt])
}

// =====================
// COMMISSION
// =====================
model Commission {
  id                String    @id @default(cuid())
  commandeId        String    @unique
  tenantId          String
  montantCommande   Float
  montantCommission Float
  montantMarchand   Float
  taux              Float
  devise            String
  statut            String    @default("pending")
  capturedAt        DateTime?
  createdAt         DateTime  @default(now())

  commande Commande @relation(fields: [commandeId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// =====================
// CODE PROMO
// =====================
model CodePromo {
  id              String    @id @default(cuid())
  tenantId        String
  code            String
  type            String
  valeur          Float
  minCommande     Float?
  maxUtilisations Int?
  utilisations    Int       @default(0)
  dateExpiration  DateTime?
  actif           Boolean   @default(true)
  createdAt       DateTime  @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  commandes Commande[]

  @@unique([tenantId, code])
}

// =====================
// AVIS CLIENT
// =====================
model Avis {
  id          String   @id @default(cuid())
  tenantId    String
  produitId   String
  clientId    String
  note        Int
  titre       String?
  commentaire String?
  verifie     Boolean  @default(false)
  approuve    Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  produit Produit @relation(fields: [produitId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  @@index([tenantId, produitId])
}

// =====================
// WISHLIST
// =====================
model Wishlist {
  id        String   @id @default(cuid())
  clientId  String
  produitId String
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id])
  produit Produit @relation(fields: [produitId], references: [id])

  @@unique([clientId, produitId])
}

// =====================
// MEMBRE ÉQUIPE
// =====================
model MembreEquipe {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String?   // lié une fois l'invitation acceptée — un compte peut être membre de plusieurs boutiques
  email           String
  nom             String
  role            String    @default("gerant") // gerant | caissier | comptable | lecture | personnalise
  permissions     Json?     // grille custom {module: "aucun"|"lecture"|"ecriture"} — utilisée si role="personnalise"
  statut          String    @default("invite") // invite | actif | suspendu
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  actif           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  // POS 2.0
  magasinIds      String[]  @default([]) // magasins où le membre peut travailler ; vide = tous
  droitsPos       Json?     // { action: true|false } — retouches de la grille POS du rôle (lib/pos/droits.ts)

  @@unique([userId, tenantId])
}

// =====================
// ANALYTICS
// =====================
model Analytics {
  id       String   @id @default(cuid())
  tenantId String
  date     DateTime @default(now())
  type     String
  valeur   Float    @default(1)
  metadata Json     @default("{}")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, type, date])
}

// =====================
// RÉSEAU SOCIAL AXSO
// =====================
model PostSocial {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   @default("post") // post | story | video | produit | milestone | sondage
  contenu     String?
  mediaUrls   String[] @default([])
  produitId   String?
  produitNom  String?
  produitPrix Float?
  produitImg  String?
  scoreValeur Float?                     // pour les milestones (CA, commandes, etc.)
  scoreLabel  String?                    // ex: "100 commandes" "500k FCFA"
  sondageOptions String[] @default([])
  sondageVotes  Int[]    @default([])
  vues         Int      @default(0)
  expireAt     DateTime?                 // stories : 24h
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reactions   ReactionSociale[]
  commentaires CommentaireSocial[]
}

model ReactionSociale {
  id        String   @id @default(cuid())
  postId    String
  tenantId  String
  emoji     String   @default("❤️")
  createdAt DateTime @default(now())

  post PostSocial @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([postId, tenantId])
}

model CommentaireSocial {
  id        String   @id @default(cuid())
  postId    String
  tenantId  String
  auteur    String   // nomBoutique
  contenu   String
  createdAt DateTime @default(now())

  post PostSocial @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// =====================
// COMPTE UTILISATEUR (NextAuth)
// =====================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  tenantId      String?
  role          String    @default("owner")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  livreur  Livreur?
  boutiques ProprietaireBoutique[]
  membresEquipe MembreEquipe[]
}

// Boutiques possédées par un compte utilisateur — permet le multi-boutique
// (Palier 2). User.tenantId reste la "boutique active" de la session (lue
// partout ailleurs dans le code) ; cette table liste TOUTES les boutiques
// auxquelles l'utilisateur a accès, indépendamment de laquelle est active.
model ProprietaireBoutique {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("owner")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)


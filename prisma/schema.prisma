model StockEntrepot {
  id         String @id @default(cuid())
  entrepotId String
  produitId  String
  varianteId String?
  quantite   Int    @default(0)
  stockMin   Int    @default(0)

  entrepot Entrepot  @relation(fields: [entrepotId], references: [id])
  produit  Produit   @relation(fields: [produitId], references: [id])
  variante Variante? @relation(fields: [varianteId], references: [id])

  // POS 2.0 — parts du stock de ce lieu qui ne sont pas vendables. DISPONIBLE = quantite − bloque − endommage.
  bloque     Int    @default(0)
  endommage  Int    @default(0)

  @@unique([entrepotId, produitId, varianteId])
  @@index([produitId])
}

// =====================
// COMMANDE FOURNISSEUR (dropshipping auto-routing)
// =====================
model CommandeFournisseur {
  id             String   @id @default(cuid())
  tenantId       String
  commandeId     String
  fournisseurId  String
  statut         String   @default("en_attente") // en_attente | envoye | confirme | expedie | livre | annule
  motifAnnulation String? // MOTIFS_ANNULATION (lib/sourcing/statuts.ts) : dit si l'annulation est imputable au fournisseur
  reference      String?
  montantFournisseur Float?
  delaiEstime    Int?
  trackingNo     String?
  notes          String?
  envoiAuto      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  commande    Commande    @relation(fields: [commandeId], references: [id])
  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id])

  @@index([tenantId, statut])
  @@index([commandeId])
}

// =====================
// AFFILIATION ENTRANTE (l'utilisateur est affilié d'un autre marchand)
// =====================
model AffiliationEntrante {
  id          String   @id @default(cuid())
  tenantId    String
  nom         String
  marchand    String
  url         String
  categorie   String?
  commission  Float    @default(0.10)
  devise      String   @default("XAF")
  clics       Int      @default(0)
  conversions Int      @default(0)
  revenus     Float    @default(0)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// =====================
// PAIEMENT DE COMMISSIONS (aux affiliés)
// =====================
model PaiementCommission {
  id          String   @id @default(cuid())
  tenantId    String
  affilieurId String
  montant     Float
  methode     String   @default("mobile_money")
  telephone   String?
  reference   String?
  statut      String   @default("en_attente") // en_attente | traite | echec
  notes       String?
  commissionIds String[] @default([]) // CommissionAffilie.id inclus dans ce paiement
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, statut])
}

// =====================
// PROGRAMME D'AFFILIATION B2C (merchant → influenceurs/clients ambassadeurs)
// =====================
model ProgrammeAffiliation {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  nom              String
  description      String?
  typeCommission   String   @default("pourcentage") // pourcentage | fixe
  valeurCommission Float    @default(10)
  dureeCookie      Int      @default(30)
  seuilPaiement    Float    @default(5000)
  tousLesProduits  Boolean  @default(true)
  produitIds       String[] @default([])
  tiersActifs      Boolean  @default(false)
  tier1Nom         String   @default("Bronze")
  tier1Max         Int      @default(10)
  tier1Commission  Float    @default(5)
  tier2Nom         String   @default("Argent")
  tier2Max         Int      @default(50)
  tier2Commission  Float    @default(8)
  tier3Nom         String   @default("Or")
  tier3Commission  Float    @default(12)
  multiNiveauActif Boolean  @default(false)
  tauxSousAffilies Float    @default(2)
  autoApprobation  Boolean  @default(true)
  actif            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  affilies Affilie[]
}

// =====================
// AFFILIÉ B2C (influenceur, client ambassadeur, apporteur d'affaires)
// =====================
model Affilie {
  id                String   @id @default(cuid())
  tenantId          String
  nom               String
  email             String
  telephone         String?
  programmeId       String?
  codeParrainage    String   @unique
  portalToken       String   @unique @default(cuid()) // accès portail self-service sans compte/login
  notes             String?
  statut            String   @default("en_attente") // en_attente | actif | suspendu
  clics             Int      @default(0)
  conversions       Int      @default(0)
  commissionTotal   Float    @default(0)
  commissionPending Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  programme  ProgrammeAffiliation? @relation(fields: [programmeId], references: [id])
  commissions CommissionAffilie[]
  clicsLog    AffilieClic[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// Historique des clics sur le lien de parrainage — le compteur Affilie.clics
// reste la source rapide (total lifetime), ce log sert uniquement aux
// graphiques jour par jour du portail affilié.
model AffilieClic {
  id        String   @id @default(cuid())
  affilieId String
  createdAt DateTime @default(now())

  affilie Affilie @relation(fields: [affilieId], references: [id])

  @@index([affilieId, createdAt])
}

// =====================
// COMMISSION AFFILIÉ B2C
// =====================
model CommissionAffilie {
  id                String   @id @default(cuid())
  tenantId          String
  affilieId         String
  commandeId        String?
  montantCommission Float
  valeurCommande    Float    @default(0)
  statut            String   @default("pending") // pending | approuvee | payee | rejetee
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  affilie Affilie @relation(fields: [affilieId], references: [id])

  @@index([tenantId])
  @@index([affilieId])
}

// ============================================================
// PRODUITS DIGITAUX AVANCÉS — Phase 0
// ============================================================

// =====================
// VARIANTE DE PRIX (transversal — tous types digitaux)
// =====================
model VariantePrix {
  id              String    @id @default(cuid())
  produitId       String
  tenantId        String
  nom             String                    // "Standard" | "Pro" | "Lifetime"
  slug            String                    // slug unique pour lien checkout
  prix            Float
  prixPromo       Float?
  periodeValidite String?                   // "30j" | "1an" | "illimite"
  renouvAuto      Boolean   @default(false) // abonnement reconductible
  autorisePromo   Boolean   @default(true)
  actif           Boolean   @default(true)
  dateDebut       DateTime?
  dateFin         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@unique([produitId, slug])
  @@index([tenantId])
}

// =====================
// PRODUIT FICHIER (type = "fichier")
// =====================
model ProduitFichier {
  id               String    @id @default(cuid())
  produitId        String    @unique
  limitAchats      Int?                      // null = illimité
  motDePasse       String?                   // hashé bcrypt
  filigrane        Boolean   @default(false) // injecter nom/email acheteur dans PDF livré
  instructionsAchat String?  @db.Text
  createdAt        DateTime  @default(now())

  produit  Produit            @relation(fields: [produitId], references: [id], onDelete: Cascade)
  fichiers FichierNumerique[]
}

// Fichiers individuels d'un produit digital (multi-fichiers avec ordre)
model FichierNumerique {
  id               String   @id @default(cuid())
  produitFichierId String
  nom              String
  url              String                   // Vercel Blob — jamais exposée directement côté client
  taille           Int?                     // octets
  mimeType         String?
  ordre            Int      @default(0)
  createdAt        DateTime @default(now())

  produitFichier ProduitFichier @relation(fields: [produitFichierId], references: [id], onDelete: Cascade)
}

// =====================
// FORMATION (type = "formation")
// =====================
model Formation {
  id        String   @id @default(cuid())
  produitId String   @unique
  niveau    String?  // "debutant" | "intermediaire" | "avance"
  langue    String   @default("fr")
  dureeMin  Int?     // durée totale estimée en minutes
  certif    Boolean  @default(false) // certificat de complétion généré
  createdAt DateTime @default(now())

  produit   Produit    @relation(fields: [produitId], references: [id], onDelete: Cascade)
  chapitres Chapitre[]
}

model Chapitre {
  id          String   @id @default(cuid())
  formationId String
  titre       String
  ordre       Int      @default(0)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())

  formation Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  lecons    Lecon[]
}

model Lecon {
  id         String   @id @default(cuid())
  chapitreId String
  titre      String
  type       String   @default("texte") // "texte" | "video" | "audio"
  contenu    String?  @db.Text          // HTML pour type texte
  videoType  String?                    // "upload" | "youtube" | "vimeo" | "iframe"
  videoUrl   String?
  audioUrl   String?
  duree      Int?                       // secondes
  ordre      Int      @default(0)
  gratuite   Boolean  @default(false)  // aperçu libre sans achat
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())

  chapitre     Chapitre           @relation(fields: [chapitreId], references: [id], onDelete: Cascade)
  progressions ProgressionLecon[]
}

model ProgressionLecon {
  id          String    @id @default(cuid())
  leconId     String
  commandeId  String                    // commande qui a donné l'accès
  clientEmail String
  complete    Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  lecon Lecon @relation(fields: [leconId], references: [id], onDelete: Cascade)

  @@unique([leconId, clientEmail])
  @@index([commandeId])
}

// Accès self-service à une formation achetée — même principe que
// Telechargement (token opaque non devinable dans l'URL), donne accès à
// l'ensemble des chapitres/leçons d'une formation, sans expiration (achat
// à vie, contrairement aux liens de téléchargement de fichiers).
model AccesFormation {
  id          String   @id @default(cuid())
  produitId   String
  commandeId  String
  token       String   @unique
  clientEmail String
  createdAt   DateTime @default(now())

  produit Produit @relation(fields: [produitId], references: [id])

  @@index([produitId])
}

// =====================
// LICENCE (type = "licence")
// =====================
model LicenceProduit {
  id             String   @id @default(cuid())
  produitId      String   @unique
  modeDistrib    String   @default("auto")  // "auto" | "stock"
  formatAuto     String   @default("uuid")  // "uuid" | "alpha"
  prefixe        String?                    // ex: "AXSO-"
  longueur       Int      @default(16)      // pour mode "alpha" (8–32)
  maxActivations Int      @default(1)
  dureeJours     Int?                       // null = illimité
  createdAt      DateTime @default(now())

  produit Produit      @relation(fields: [produitId], references: [id], onDelete: Cascade)
  cles    CleLicence[]
}

model CleLicence {
  id               String    @id @default(cuid())
  licenceProduitId String
  cle              String    @unique
  statut           String    @default("disponible") // disponible | vendue | expiree | revoquee
  commandeId       String?                          // commande qui a attribué la clé
  acheteurEmail    String?
  expireAt         DateTime?
  createdAt        DateTime  @default(now())

  licenceProduit LicenceProduit      @relation(fields: [licenceProduitId], references: [id], onDelete: Cascade)
  activations    ActivationLicence[]

  @@index([licenceProduitId, statut])
}

model ActivationLicence {
  id          String   @id @default(cuid())
  cleId       String
  appareil    String?                    // identifiant appareil ou user-agent
  ipAdresse   String?
  activatedAt DateTime @default(now())

  cle CleLicence @relation(fields: [cleId], references: [id], onDelete: Cascade)

  @@index([cleId])
}

// =====================
// BUNDLE (type = "bundle")
// =====================
model BundleProduit {
  id        String   @id @default(cuid())
  produitId String   @unique
  createdAt DateTime @default(now())

  produit  Produit         @relation(fields: [produitId], references: [id], onDelete: Cascade)
  elements ElementBundle[]
}

model ElementBundle {
  id              String @id @default(cuid())
  bundleId        String
  produitInclusId String
  ordre           Int    @default(0)

  bundle        BundleProduit @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  produitInclus Produit       @relation("InclusDansBundle", fields: [produitInclusId], references: [id])

  @@unique([bundleId, produitInclusId])
}

// =====================
// POS — STOCK, TRAÇABILITÉ, COMPTABILITÉ BOUTIQUE PHYSIQUE
// Inspiré de la logique d'un logiciel de gestion de boucherie (lots de
// traçabilité, mouvements de stock horodatés, charges d'exploitation) —
// généralisé ici à tout produit physique, pas seulement l'alimentaire.
// =====================

// Journal de tout changement de stock — entrée (réassort), sortie (vente),
// ajustement manuel (inventaire), perte (casse/péremption). Source de vérité
// pour la traçabilité, distincte de Produit.stock qui n'est qu'un solde.
model StockMouvement {
  id         String   @id @default(cuid())
  tenantId   String
  produitId  String
  type       String   // entree | sortie | ajustement | perte | vente
  quantite   Float    // toujours positive — le sens est porté par `type`
  stockAvant Float
  stockApres Float
  motif      String?
  lotId      String?
  commandeId String?  // commande POS à l'origine, si type = "vente"
  creePar    String?  // userId de l'auteur du mouvement manuel
  createdAt  DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  produit Produit         @relation(fields: [produitId], references: [id])
  lot     LotTracabilite? @relation(fields: [lotId], references: [id])

  // POS 2.0 — types ajoutés : retour | transfert_sortie | transfert_entree | reception | inventaire
  entrepotId  String?
  varianteId  String?
  transfertId String?
  comptageId  String?
  receptionId String?

  @@index([tenantId, produitId, createdAt])
  @@index([tenantId, createdAt])
  @@index([commandeId])
}

// Lot de réception — traçabilité amont (fournisseur → rayon) et péremption.
// Consommé en FIFO par les ventes (LigneCommande.lotId) pour pouvoir remonter
// de toute vente au lot d'origine en cas de rappel.
model LotTracabilite {
  id               String    @id @default(cuid())
  tenantId         String
  produitId        String
  codeLot          String
  quantiteInitiale Float
  quantiteRestante Float
  fournisseurNom   String?
  fournisseurRef   String?
  dateReception    DateTime  @default(now())
  dateExpiration   DateTime?
  certification    String?   // certificat sanitaire / halal / bio / origine — libre
  statut           String    @default("actif") // actif | epuise | perime | rappele
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  produit    Produit          @relation(fields: [produitId], references: [id])
  mouvements StockMouvement[]
  ventes     LigneCommande[]

  // POS 2.0 — statut ajouté : bloque (jamais consommé par une vente)
  cout          Float?  // coût unitaire d'achat du lot
  fournisseurId String?
  entrepotId    String? // lieu où se trouve le lot ; null = non localisé (consommable partout)

  @@unique([tenantId, codeLot])
  @@index([tenantId, produitId])
  @@index([tenantId, statut])
}

// Charge d'exploitation de la boutique physique (loyer, salaires, énergie...)
// — base des "fonds généraux" du rapport de comptabilité POS, en miroir des
// ventes pour calculer un vrai résultat net (pas juste un chiffre d'affaires).
model ChargeExploitation {
  id                 String    @id @default(cuid())
  tenantId           String
  categorie          String    // loyer | electricite | eau | internet | fournitures | equipement | salaires | transport | autre
  description        String
  montant            Float
  devise             String    @default("XAF")
  frequence          String    @default("ponctuelle") // ponctuelle | hebdomadaire | mensuelle | annuelle
  dateEnregistrement DateTime  @default(now())
  dateEcheance       DateTime?
  statut             String    @default("payee") // en_attente | payee | en_retard
  fournisseur        String?
  reference          String?
  notes              String?
  creePar            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // POS 2.0 — dépense sortie d'une caisse
  magasinId          String?
  sessionCaisseId    String?

  @@index([tenantId, dateEnregistrement])
  @@index([tenantId, statut])
}

// Catégories de produits propres à une boutique (Catalogue → Catégories).
// Produit.categorie garde le NOM de la catégorie (filtres du catalogue,
// recherche, AXIA) ; renommer / supprimer une catégorie met ses produits à jour.
// `options` : options de variantes proposées pour cette catégorie,
// ex. [{ "nom": "Taille", "valeurs": ["28", "30", "32"] }].
model CategorieProduit {
  id        String   @id @default(cuid())
  tenantId  String
  nom       String
  slug      String
  ordre     Int      @default(0)
  options   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, ordre])
}

// =====================
// AXIA PROPOSITION (prises de parole d'AXIA dans la bulle du dashboard :
// constats sur la boutique et demandes de confirmation d'actions sensibles)
// =====================
model AxiaProposition {
  id        String   @id @default(cuid())
  tenantId  String
  type      String   // ventes_hausse | ventes_baisse | stock_bas | … | confirmation
  cle       String   // anti-doublon : un même constat n'est créé qu'une fois
  message   String   @db.Text
  action    Json?    // { prompt } | { lien } | { outil, args, agent? } (confirmation)
  statut    String   @default("nouveau") // nouveau | vu | accepte | refuse | execute | echec
  resultat  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, cle])
  @@index([tenantId, statut])
}

// =====================
// ADMIN AXIA ACTION (actions demandées à AXIA dans l'administration, en
// attente de l'accord de l'admin — séparé des propositions marchand)
// =====================
model AdminAxiaAction {
  id        String   @id @default(cuid())
  adminId   String   // admin qui a fait la demande — le seul à pouvoir l'autoriser
  outil     String
  args      Json
  message   String   @db.Text
  statut    String   @default("en_attente") // en_attente | accepte | refuse | execute | echec
  resultat  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, statut])
}

// ===== SUPPLIER INTELLIGENCE =====
// Moteur de vérification, comparaison et scoring des fournisseurs
// (lib/sourcing/fournisseurs). Règle : rien n'est « vérifié » par défaut. Les
// niveaux de confiance sont verifie | partiellement_verifie | declare_fournisseur
// | inconnu, toujours accompagnés de la source de vérification.

// Offre d'un fournisseur pour un produit (relation Produit ↔ Fournisseur).
// produitId est vide tant que le produit sourcé n'est pas encore au catalogue.
model ProduitFournisseur {
  id              String   @id @default(cuid())
  tenantId        String
  fournisseurId   String
  produitId       String?
  nomProduit      String   // désignation chez le fournisseur
  categorie       String?  // sert à déterminer les certifications potentiellement nécessaires
  urlOffre        String?
  prixUnitaire    Float    // prix de base, dans `devise`
  devise          String   @default("USD")
  paliers         Json     @default("[]") // [{ quantiteMin: Int, prix: Float }] — prix dégressifs
  moq             Int?
  delaiProduction Int?     // jours, avant expédition
  poidsKg         Float?   // poids unitaire, pour le coût rendu
  disponible      Boolean  @default(true)
  source          String   @default("saisie") // saisie | connecteur | extraction_ia | devis
  confiance       String   @default("declare_fournisseur") // niveau de confiance du prix et du MOQ
  // Cache de la dernière analyse (pays et quantité du dernier calcul)
  scoreQualite       Int?
  scoreCertification Int?
  scoreLogistique    Int?
  scoreRisque        Int?
  scoreFournisseur   Int?
  coutRenduTotal     Float?  // coût réel estimé par unité, dans `coutRenduDevise`
  coutRenduDevise    String?
  derniereVerificationAt DateTime? // dernière confirmation du prix / de la disponibilité
  recommandeDepuis   DateTime? // devenue la meilleure offre du produit sans en être le fournisseur actuel
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  produit     Produit?    @relation(fields: [produitId], references: [id], onDelete: SetNull)

  principal       Boolean  @default(false) // POS 2.0 — fournisseur principal du produit (réassort)

  @@index([tenantId, produitId])
  @@index([fournisseurId])
}

// Document fourni par le fournisseur (ou par le marchand pour lui) : certificat,
// rapport de laboratoire, licence… Jamais « vérifié » sans vérificateur tracé.
model DocumentFournisseur {
  id                 String    @id @default(cuid())
  tenantId           String
  fournisseurId      String
  type               String    // certificat | rapport_labo | licence | document_entreprise | rapport_inspection | document_qualite
  certification      String?   // pour un certificat : CE, RoHS, FCC, ISO 9001…
  nom                String
  url                String?   // fichier (Vercel Blob) — sans fichier, la certification est « non vérifiable »
  organismeEmetteur  String?
  numero             String?
  dateEmission       DateTime?
  dateExpiration     DateTime?
  statutVerification String    @default("declare_fournisseur") // verifie | partiellement_verifie | declare_fournisseur | inconnu | rejete
  sourceVerification String?   // qui / quoi a vérifié (ex. « Admin AXSO — registre de l'organisme »)
  verifieParId       String?
  verifieLe          DateTime?
  alerteExpirationLe DateTime? // dernière alerte d'expiration envoyée (anti-doublon)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  @@index([tenantId, fournisseurId])
  @@index([dateExpiration])
}

// Audit ou inspection réalisé par un prestataire tiers. Aucun audit n'est créé
// par AXSO lui-même : rapport saisi par le marchand (déclaré) ou reçu d'un
// prestataire connecté (voir lib/sourcing/fournisseurs/services-tiers.ts).
model AuditFournisseur {
  id            String    @id @default(cuid())
  tenantId      String
  fournisseurId String
  type          String    // avant_production | pendant_production | avant_expedition | controle_qualite | audit_usine
  prestataire   String
  statut        String    @default("demande") // demande | planifie | reussi | echoue | annule
  dateAudit     DateTime?
  rapportUrl    String?
  reference     String?   // référence chez le prestataire
  confiance     String    @default("declare_fournisseur")
  sourceVerification String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  @@index([tenantId, fournisseurId])
}

// Commande d'échantillon et contrôle à réception (checklist du marchand).
model EchantillonFournisseur {
  id            String    @id @default(cuid())
  tenantId      String
  fournisseurId String
  offreId       String?   // ProduitFournisseur concerné
  nomProduit    String
  quantite      Int       @default(1)
  cout          Float?
  devise        String    @default("USD")
  statut        String    @default("a_commander") // a_commander | commande | recu | controle | refuse_par_fournisseur
  commandeLe    DateTime?
  recuLe        DateTime?
  checklist     Json      @default("{}") // { qualite|packaging|finition|fonctionnement|conformite|photos|delai: { note: 1-5, commentaire? } }
  verdict       String?   // conforme | reserves | non_conforme
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  @@index([tenantId, fournisseurId])
}

// Évaluation du marchand après une commande reçue : seule source de qualité
// réellement constatée (alimente le score, à la différence des données déclarées).
model EvaluationFournisseur {
  id                  String   @id @default(cuid())
  tenantId            String
  fournisseurId       String
  offreId             String?  // ProduitFournisseur concerné
  commandeFournisseurId String?
  qualite             Int      // 1–5
  conformite          Int
  emballage           Int
  delai               Int
  communication       Int
  unitesRecues        Int      @default(0)
  unitesDefectueuses  Int      @default(0)
  delaiReelJours      Int?
  commentaire         String?
  createdAt           DateTime @default(now())

  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  @@index([tenantId, fournisseurId])
}

// Journal des vérifications et des changements d'un champ du fournisseur.
// Le niveau de confiance d'un champ = sa dernière ligne. « verifie » ne peut
// être écrit que par un admin AXSO ou une source tierce nommée (verifieParId / source).
model VerificationFournisseur {
  id            String   @id @default(cuid())
  tenantId      String
  fournisseurId String
  champ         String   // identite | entreprise | fabricant | email | telephone | url | adresseUsine | …
  niveau        String   // verifie | partiellement_verifie | declare_fournisseur | inconnu
  source        String   // ex. « Saisie du marchand », « Admin AXSO — registre du commerce »
  verifieParId  String?
  note          String?
  createdAt     DateTime @default(now())

  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  @@index([fournisseurId, champ, createdAt])
}

// Demande de devis standardisée (RFQ), adressée à un ou plusieurs fournisseurs.
model DemandeDevis {
  id               String   @id @default(cuid())
  tenantId         String
  reference        String
  produitId        String?
  nomProduit       String
  description      String?  @db.Text
  quantite         Int
  prixCible        Float?
  devise           String   @default("USD")
  paysDestination  String   // code ISO2
  villeDestination String?
  incoterm         String?  // vide = « à déterminer selon la solution logistique »
  couleur          String?
  packaging        String?
  personnalisation String?
  contenu          String   @db.Text // texte standardisé envoyé aux fournisseurs
  statut           String   @default("brouillon") // brouillon | envoye | clos
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reponses ReponseDevis[]

  @@unique([tenantId, reference])
  @@index([tenantId, statut])
}

// Un destinataire du RFQ : trace de l'envoi puis réponse du fournisseur
// (collée par le marchand ; les champs sont extraits par l'IA puis corrigeables).
model ReponseDevis {
  id                 String    @id @default(cuid())
  demandeDevisId     String
  fournisseurId      String
  statutEnvoi        String    @default("non_envoye") // non_envoye | envoye_email | copie_manuelle | echec
  envoyeLe           DateTime?
  texteBrut          String?   @db.Text
  recuLe             DateTime?
  prixUnitaire       Float?
  devise             String?
  moq                Int?
  delaiJours         Int?
  packaging          String?
  personnalisation   String?
  expedition         String?
  conditionsPaiement String?
  extraitPar         String?   // ia | manuel
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  demande     DemandeDevis @relation(fields: [demandeDevisId], references: [id], onDelete: Cascade)
  fournisseur Fournisseur  @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  @@unique([demandeDevisId, fournisseurId])
}
// ===== FIN SUPPLIER INTELLIGENCE =====

// ===== DROPSHIPPING ENGINE =====
// Modèles d'AXSO Sourcing (lib/sourcing/). Aucune relation Prisma vers les
// modèles existants : les liens sont de simples ids, toujours filtrés par tenantId.

// Produit repéré chez un fournisseur (connecteur ou saisie manuelle), suivi de
// la découverte jusqu'à la marque : fiche source, hypothèses de coût, prix,
// score, contenus IA. `produitId` = le produit de la boutique une fois publié.
model ProduitSource {
  id                String   @id @default(cuid())
  tenantId          String
  connecteur        String   @default("manuel") // id du SupplierConnector (lib/sourcing/connecteurs.ts)
  refExterne        String?  // identifiant du produit chez le fournisseur
  url               String?
  nom               String
  description       String?  @db.Text
  images            String[] @default([])
  videos            String[] @default([])
  variantes         Json     @default("[]") // [{ nom, valeur, prix?, sku?, stock? }]
  prixFournisseur   Float
  deviseFournisseur String   @default("USD")
  moq               Int      @default(1)
  poidsKg           Float?
  dimensions        Json?    // { longueurCm, largeurCm, hauteurCm }
  logistique        Json?    // { delaiJours?, modes?, origine? }
  sku               String?
  disponibilite     Int?     // stock annoncé par le fournisseur ; null = inconnu
  fournisseurNom    String?
  fournisseurId     String?  // Fournisseur du marchand, s'il est rattaché
  favori            Boolean  @default(false)
  etape             String   @default("decouverte") // decouverte | test | validation | stock | marque | scale
  modeAppro         String   @default("dropshipping") // dropshipping | stock_axso | stock_vendeur
  parametresCout    Json     @default("{}") // hypothèses du calculateur de coût réel
  tarification      Json     @default("{}") // { mode, margeFixe?, margePct?, prixVente? }
  criteresScore     Json     @default("{}") // estimations du marchand (1 à 5) par critère
  score             Int?     // dernier score /100 calculé
  analyseIA         Json?    // copilote produit
  kitTest           Json?    // centre de test : page, angles marketing
  publicites        Json?    // centre publicitaire : variantes
  produitId         String?  // Produit de la boutique créé à la publication
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, connecteur, refExterne])
  @@index([tenantId, etape])
  @@index([tenantId, produitId])
}

// Expédition internationale (fournisseur → pays → entrepôt local). La livraison
// au client final reste le cycle de commande existant (lib/cycle-livraison.ts).
model Expedition {
  id                    String    @id @default(cuid())
  tenantId              String
  commandeFournisseurId String?   // dropshipping : la commande fournisseur transportée
  commandeId            String?   // commande client concernée
  produitSourceId       String?   // import en stock : le produit réapprovisionné
  quantite              Int?
  mode                  String    @default("aerien") // aerien | maritime | express | routier
  transporteur          String?
  transitaire           String?
  trackingNo            String?
  statut                String    @default("en_preparation") // en_preparation | expediee | en_transit | arrivee_pays | douane | entrepot_local | annulee
  paysOrigine           String    @default("CN")
  paysDestination       String
  pointEntree           String?
  entrepotId            String?
  poidsKg               Float?
  cout                  Float?
  devise                String    @default("XAF")
  dateExpedition        DateTime?
  arriveeEstimee        DateTime?
  arriveeReelle         DateTime?
  stockRecu             Boolean   @default(false) // entrée en stock faite à l'arrivée (jamais deux fois)
  evenements            Json      @default("[]") // [{ statut, date, note? }]
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenantId, statut])
  @@index([commandeId])
}

// Réglages Sourcing d'une boutique : pays de vente et hypothèses de coût
// (droits, transitaire, refus…) qui remplacent les valeurs de départ du pays.
model ReglagesSourcing {
  tenantId  String   @id
  reglages  Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// Journal d'audit des actions Sourcing (import, publication, changement de
// prix ou de mode, commande fournisseur, expédition).
model JournalSourcing {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  cible     String?  // « ProduitSource:id », « Expedition:id »…
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
// ===== FIN DROPSHIPPING ENGINE =====

// ===== POS 2.0 =====
// Caisse, magasins, stock par lieu, achats, fidélité, crédit, audit (lib/pos/).
// Schéma strictement additif : la production applique `prisma db push`.
// Une vente en caisse reste une `Commande` (canal = "pos") ; les modèles
// ci-dessous portent tout ce qui l'entoure. Les `tenantId` sont de simples
// colonnes (pas de relation Prisma), comme ReglagesSourcing / JournalSourcing.

// Point de vente physique. Son stock est celui de son entrepôt (`entrepotId`) :
// les transferts se font d'entrepôt à entrepôt, magasin ou dépôt.
model Magasin {
  id           String   @id @default(cuid())
  tenantId     String
  nom          String
  code         String?
  adresse      String?
  ville        String?
  pays         String?
  telephone    String?
  entrepotId   String
  typeCommerce String?  // RETAIL | SUPERMARKET | … ; null = celui de ReglagesPos
  actif        Boolean  @default(true)
  demo         Boolean  @default(false) // données de démonstration, toujours étiquetées
  createdAt    DateTime @default(now())

  entrepot Entrepot @relation(fields: [entrepotId], references: [id])
  caisses  Caisse[]

  @@unique([tenantId, nom])
  @@index([tenantId])
}

model Caisse {
  id              String    @id @default(cuid())
  tenantId        String
  magasinId       String
  nom             String
  actif           Boolean   @default(true)
  dernierSignalAt DateTime? // dernier signe de vie du poste (supervision)
  ecranVenteAt    DateTime? // dernier signe de vie de l'écran de VENTE : sans lui, un scan de vente venu d'un téléphone est refusé
  createdAt       DateTime  @default(now())

  magasin  Magasin         @relation(fields: [magasinId], references: [id])
  sessions SessionCaisse[]

  @@unique([magasinId, nom])
  @@index([tenantId])
}

// Appareil enregistré (téléphone-scanner, tablette, poste). Le jeton n'est
// jamais stocké en clair : `tokenHash` = SHA-256 du jeton remis à l'appareil.
model AppareilPos {
  id              String    @id @default(cuid())
  tenantId        String
  magasinId       String?
  caisseId        String?
  type            String    @default("telephone") // telephone | tablette | pc
  nom             String
  statut          String    @default("en_attente") // en_attente | actif | revoque
  codeAppairage   String?   @unique
  codeExpireAt    DateTime?
  essais          Int       @default(0) // essais d'appairage ratés (limite tenue en base)
  tokenHash       String?   @unique
  appairePar      String    // userId du marchand qui a autorisé l'appareil : ses droits bornent ceux de l'appareil
  userAgent       String?
  dernierSignalAt DateTime?
  revoqueAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, statut])
  @@index([caisseId])
}

// Session de caisse : de l'ouverture (fonds initial) à la fermeture (comptage).
// `caisseOuverteId` = caisseId tant que la session est ouverte, puis NULL :
// son unicité garantit UNE SEULE session ouverte par caisse.
model SessionCaisse {
  id                 String    @id @default(cuid())
  tenantId           String
  magasinId          String
  caisseId           String
  caisseOuverteId    String?   @unique
  statut             String    @default("ouverte") // ouverte | fermee
  ouvertePar         String
  fermeePar          String?
  fondsInitial       Float     @default(0)
  ouverteAt          DateTime  @default(now())
  fermeeAt           DateTime?
  nbVentes           Int       @default(0) // incrémenté par chaque vente : verrouille la ligne, la fermeture attend les ventes en cours
  montantAttendu     Float?
  montantCompte      Float?
  ecart              Float?    // compté − attendu
  justificationEcart String?
  detailComptage     Json?     // { "10000": 12, "5000": 3, … } billets et pièces comptés

  caisse     Caisse            @relation(fields: [caisseId], references: [id])
  mouvements MouvementCaisse[]

  @@index([tenantId, statut])
  @@index([caisseId, ouverteAt])
}

// Entrée ou sortie d'espèces hors vente. `montant` positif, sauf `correction` (signé).
model MouvementCaisse {
  id              String   @id @default(cuid())
  tenantId        String
  sessionCaisseId String
  type            String   // retrait | depot | depense | correction
  montant         Float
  motif           String
  chargeId        String?  // ChargeExploitation créée pour une dépense
  creePar         String
  createdAt       DateTime @default(now())

  session SessionCaisse @relation(fields: [sessionCaisseId], references: [id])

  @@index([sessionCaisseId])
  @@index([tenantId, createdAt])
}

// Un règlement d'une vente (une vente peut en avoir plusieurs : paiement mixte).
// `declaratif` = le caissier a confirmé lui-même (Mobile Money, carte sur TPE
// externe, virement, QR) : JAMAIS vérifié par un prestataire, à rapprocher.
// Un remboursement est une ligne de montant NÉGATIF au statut "rembourse".
model PaiementVente {
  id              String    @id @default(cuid())
  tenantId        String
  commandeId      String
  sessionCaisseId String?
  mode            String    // especes | mobile_money | carte | virement | qr | portefeuille | credit | bon | avoir
  montant         Float     // part de la vente réglée par ce paiement (hors monnaie rendue)
  devise          String    @default("XAF")
  statut          String    @default("confirme") // confirme | en_attente | echoue | rembourse
  declaratif      Boolean   @default(false)
  prestataire     String?   // mtn | orange | wave | tpe… (information saisie)
  reference       String?   // n° de transaction saisi, code de l'avoir…
  montantRecu     Float?    // espèces remises par le client
  monnaieRendue   Float?
  rapprochement   String    @default("a_rapprocher") // a_rapprocher | rapproche | ecart | inconnu
  rapprocheAt     DateTime?
  encaissePar     String
  createdAt       DateTime  @default(now())

  commande Commande @relation(fields: [commandeId], references: [id])

  @@index([commandeId])
  @@index([sessionCaisseId])
  @@index([tenantId, createdAt])
  @@index([tenantId, rapprochement])
}

model PanierSuspendu {
  id        String    @id @default(cuid())
  tenantId  String
  magasinId String
  caisseId  String
  creePar   String
  libelle   String?
  clientId  String?
  contenu   Json      // lignes du panier telles que saisies ; les prix sont recalculés à la reprise
  total     Float     @default(0)
  statut    String    @default("suspendu") // suspendu | repris | abandonne
  createdAt DateTime  @default(now())
  reprisAt  DateTime?

  @@index([tenantId, magasinId, statut])
}

// Chaque lecture de code-barres, quelle que soit sa source. `scanId` vient de
// l'appareil : le même scan rejoué n'est enregistré qu'une fois.
model ScanPos {
  id              String   @id @default(cuid())
  tenantId        String
  scanId          String
  appareilId      String?
  userId          String?
  magasinId       String?
  caisseId        String?
  sessionCaisseId String?
  contexte        String   @default("vente") // vente | inventaire | reception | transfert | recherche | prix | stock | creation
  codeBarres      String
  resultat        String   // trouve | inconnu | ambigu
  produitId       String?
  varianteId      String?
  source          String   @default("camera") // camera | clavier | mobile
  scanneAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([tenantId, scanId])
  @@index([tenantId, caisseId, createdAt])
}

// Bus temps réel : un événement par fait métier, écrit dans la transaction du
// fait. Lu par curseur (`seq`) — rejouable, sans perte. Purgé après 24 h.
model EvenementPos {
  seq       BigInt   @id @default(autoincrement())
  tenantId  String
  magasinId String?
  caisseId  String?
  type      String   // scan.created | sale.created | cash.opened | …
  payload   Json
  createdAt DateTime @default(now())

  @@index([tenantId, caisseId, seq])
  @@index([tenantId, seq])
  @@index([createdAt])
}

// Registre d'idempotence : une mutation (vente, ouverture de caisse, mouvement
// de stock…) porte une clé générée par l'appareil. Rejouée, elle renvoie le
// résultat déjà stocké au lieu de s'appliquer deux fois.
model MutationPos {
  id          String    @id @default(cuid())
  tenantId    String
  cle         String
  type        String
  appareilId  String?
  userId      String?
  statut      String    @default("appliquee") // appliquee | rejetee | conflit
  resultat    Json
  creeLocalAt DateTime?
  recueAt     DateTime  @default(now())

  @@unique([tenantId, cle])
  @@index([tenantId, statut, recueAt])
}

model Promotion {
  id           String    @id @default(cuid())
  tenantId     String
  nom          String
  type         String    // pourcentage | montant_fixe | x_pour_y | lot | achete_x_obtiens_y | seuil_panier | produit_offert | prix_membre | prix_grossiste
  valeur       Float?
  regles       Json      @default("{}") // cibles (produits, catégories, clients), quantités, seuils — lib/pos/promotions
  cumulable    Boolean   @default(false)
  priorite     Int       @default(0)
  dateDebut    DateTime?
  dateFin      DateTime?
  magasinIds   String[]  @default([]) // vide = tous les magasins
  codePromoId  String?   // promotion déclenchée par un coupon (CodePromo)
  actif        Boolean   @default(true)
  utilisations Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([tenantId, actif])
}

model MouvementFidelite {
  id         String   @id @default(cuid())
  tenantId   String
  clientId   String
  type       String   // gain | utilisation | ajustement | annulation
  points     Int      // signé
  commandeId String?
  motif      String?
  createdAt  DateTime @default(now())

  @@index([tenantId, clientId, createdAt])
  @@index([commandeId])
}

// Compte client (ardoise) : `montant` signé (+ vente à crédit, − remboursement).
model MouvementCredit {
  id              String    @id @default(cuid())
  tenantId        String
  clientId        String
  type            String    // vente | remboursement | ajustement
  montant         Float
  soldeApres      Float
  commandeId      String?
  paiementVenteId String?
  echeanceAt      DateTime?
  creePar         String
  createdAt       DateTime  @default(now())

  @@index([tenantId, clientId, createdAt])
  @@index([commandeId])
}

model AvoirClient {
  id             String    @id @default(cuid())
  tenantId       String
  clientId       String?
  code           String
  montantInitial Float
  solde          Float
  retourId       String?
  expireAt       DateTime?
  statut         String    @default("actif") // actif | epuise | expire | annule
  createdAt      DateTime  @default(now())

  @@unique([tenantId, code])
  @@index([tenantId, clientId])
}

// Numéro de série / IMEI d'une unité. Un numéro "vendu" ne se revend pas.
model NumeroSerie {
  id              String    @id @default(cuid())
  tenantId        String
  produitId       String
  varianteId      String?
  numero          String
  statut          String    @default("en_stock") // en_stock | vendu | retourne | defectueux | bloque
  entrepotId      String?
  lotId           String?
  commandeId      String?
  ligneCommandeId String?
  clientId        String?
  venduAt         DateTime?
  garantieFinAt   DateTime?
  coutAchat       Float?
  createdAt       DateTime  @default(now())

  produit Produit @relation(fields: [produitId], references: [id])

  @@unique([tenantId, numero])
  @@index([tenantId, produitId, statut])
}

model ComptageInventaire {
  id         String    @id @default(cuid())
  tenantId   String
  entrepotId String
  type       String    @default("partiel") // complet | partiel | rayon | categorie | produit | cyclique
  perimetre  Json      @default("{}")
  statut     String    @default("brouillon") // brouillon | en_cours | a_valider | valide | annule
  creePar    String
  validePar  String?
  demarreAt  DateTime  @default(now())
  valideAt   DateTime?
  notes      String?

  lignes LigneComptage[]

  @@index([tenantId, statut])
}

// `cleArticle` = produitId + ":" + (varianteId ou "") : clé unique sans le piège des NULL.
model LigneComptage {
  id                String    @id @default(cuid())
  comptageId        String
  cleArticle        String
  produitId         String
  varianteId        String?
  quantiteTheorique Int
  quantiteComptee   Int?
  ecart             Int?
  comptePar         String?
  compteAt          DateTime?

  comptage ComptageInventaire @relation(fields: [comptageId], references: [id], onDelete: Cascade)
  produit  Produit            @relation(fields: [produitId], references: [id])

  @@unique([comptageId, cleArticle])
}

model TransfertStock {
  id                    String    @id @default(cuid())
  tenantId              String
  numero                String
  entrepotSourceId      String
  entrepotDestinationId String
  statut                String    @default("brouillon") // brouillon | demande | approuve | en_preparation | expedie | recu | partiellement_recu | annule
  demandePar            String
  approuvePar           String?
  expedieAt             DateTime?
  recuAt                DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())

  lignes LigneTransfert[]

  @@unique([tenantId, numero])
  @@index([tenantId, statut])
}

model LigneTransfert {
  id               String  @id @default(cuid())
  transfertId      String
  cleArticle       String
  produitId        String
  varianteId       String?
  quantiteDemandee Int
  quantiteExpediee Int     @default(0)
  quantiteRecue    Int     @default(0)

  transfert TransfertStock @relation(fields: [transfertId], references: [id], onDelete: Cascade)
  produit   Produit        @relation(fields: [produitId], references: [id])

  @@unique([transfertId, cleArticle])
  @@index([produitId])
}

// Bon de commande de réassort. (CommandeFournisseur reste le routage dropshipping.)
model BonCommande {
  id            String    @id @default(cuid())
  tenantId      String
  numero        String
  fournisseurId String
  entrepotId    String
  statut        String    @default("brouillon") // brouillon | envoye | confirme | partiellement_recu | recu | annule
  devise        String    @default("XAF")
  montantTotal  Float     @default(0)
  dateAttendue  DateTime?
  source        String    @default("manuel") // manuel | reappro | axia
  creePar       String
  notes         String?
  createdAt     DateTime  @default(now())

  fournisseur Fournisseur        @relation(fields: [fournisseurId], references: [id])
  lignes      LigneBonCommande[]

  @@unique([tenantId, numero])
  @@index([tenantId, statut])
}

model LigneBonCommande {
  id            String  @id @default(cuid())
  bonCommandeId String
  produitId     String
  varianteId    String?
  quantite      Int
  quantiteRecue Int     @default(0)
  prixUnitaire  Float

  bonCommande BonCommande @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)
  produit     Produit     @relation(fields: [produitId], references: [id])

  @@index([bonCommandeId])
  @@index([produitId])
}

model ReceptionAchat {
  id            String   @id @default(cuid())
  tenantId      String
  bonCommandeId String?
  fournisseurId String?
  entrepotId    String
  statut        String   @default("en_cours") // en_cours | validee
  reference     String?  // n° du bon de livraison
  recuPar       String
  recuAt        DateTime @default(now())

  lignes LigneReception[]

  @@index([tenantId, recuAt])
  @@index([bonCommandeId])
}

// `coutUnitaire` fait foi pour le dernier prix d'achat et l'historique des prix.
model LigneReception {
  id           String   @id @default(cuid())
  receptionId  String
  produitId    String
  varianteId   String?
  quantite     Int
  coutUnitaire Float
  lotId        String?
  numerosSerie String[] @default([])

  reception ReceptionAchat @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  produit   Produit        @relation(fields: [produitId], references: [id])

  @@index([receptionId])
  @@index([produitId])
}

// Journal d'audit de la caisse — ajout seul. Chaque ligne porte le hachage de
// la précédente (`hashPrecedent`) : toute modification casse la chaîne
// (lib/pos/audit.ts). Un trigger SQL interdit UPDATE et DELETE (migration pos_v2).
model JournalAudit {
  id              String   @id @default(cuid())
  seq             Int      @default(autoincrement()) // ordre d'écriture, par boutique sous verrou
  tenantId        String
  magasinId       String?
  caisseId        String?
  appareilId      String?
  sessionCaisseId String?
  userId          String?
  userNom         String?
  action          String   // vente.creee | vente.annulee | caisse.ouverte | stock.ajuste | …
  entite          String   // Commande | SessionCaisse | Produit | …
  entiteId        String?
  avant           Json?
  apres           Json?
  motif           String?
  ip              String?
  hashPrecedent   String?
  hash            String
  createdAt       DateTime @default(now())

  @@index([tenantId, seq])
  @@index([tenantId, createdAt])
  @@index([tenantId, entite, entiteId])
}

// Réglages de la caisse d'une boutique (lib/pos/flags.ts).
model ReglagesPos {
  tenantId     String   @id
  typeCommerce String   @default("RETAIL") // RETAIL | SUPERMARKET | WHOLESALE | FASHION | ELECTRONICS | PHARMACY | RESTAURANT | GROCERY | HARDWARE | SERVICES
  mode         String   @default("simple") // simple | pro
  flags        Json     @default("{}") // drapeaux de fonctionnalité (FLAGS_POS)
  reglages     Json     @default("{}") // taxes, plafonds de remise, fidélité, crédit, reçu, retours, modes de paiement
  onboarding   Json     @default("{}") // étapes de mise en route franchies
  updatedAt    DateTime @updatedAt
}
// ===== FIN POS 2.0 =====

// =====================
// AXSO CONTROL — IA externes (Claude, ChatGPT, Gemini…) reliées à une boutique
// par OAuth, sans jamais recevoir d'identifiants Axso (lib/controle-ia).
// =====================
model ConnexionIA {
  id        String    @id @default(cuid())
  userId    String    // compte qui a autorisé : l'IA n'a jamais plus de droits que lui
  tenantId  String    // boutique choisie à l'autorisation, jamais lue d'une requête
  client    String    // nom déclaré par l'IA (« Claude », « ChatGPT »…)
  fournisseur String  @default("autre") // claude | chatgpt | gemini | autre (lib/controle-ia/regles.ts)
  boutiques String[]  // boutiques autorisées ; tenantId est celle sur laquelle l'IA travaille
  scopes    String[]
  mode      String    @default("copilot") // assistant | copilot | autopilot
  capacitesClient Json @default("{}") // ce que le client MCP sait faire (initialize) : confirmation, interface…
  limites   Json      @default("{}") // { variationPrixMax (%), budgetPubMax, transactionMax }
  revoqueLe DateTime?
  utiliseLe DateTime?
  createdAt DateTime  @default(now())

  jetons  JetonIA[]
  actions ActionIA[]

  @@index([tenantId])
  @@index([userId])
}

// Codes d'autorisation et jetons : seule l'empreinte SHA-256 est gardée.
model JetonIA {
  hash        String   @id
  type        String   // code | acces | rafraichissement
  connexionId String?  // vide pour un code (la connexion naît à l'échange)
  expireLe    DateTime
  donnees     Json?    // code : { userId, tenantId, client, scopes, clientId, redirectUri, challenge }

  connexion ConnexionIA? @relation(fields: [connexionId], references: [id], onDelete: Cascade)

  @@index([connexionId])
  @@index([expireLe])
}

// Journal de chaque appel d'outil fait par une IA externe (audit + idempotence).
model ActionIA {
  id             String   @id @default(cuid())
  tenantId       String
  connexionId    String
  client         String
  outil          String
  risque         String   // faible | moyen | eleve
  entree         String   @db.Text // résumé des paramètres, tronqué
  sortie         String   @default("") @db.Text
  statut         String   @default("en_cours") // en_cours | execute | echec | refuse | accord_demande
  cleIdempotence String?
  dureeMs        Int      @default(0)
  requete        String?  // identifiant de la requête MCP (suivi dans les journaux)
  args           Json?    // paramètres complets d'une action en attente d'accord ou annulable
  ressources     Json?    // reçu : [{ type, id }] des éléments modifiés
  avant          Json?    // reçu : valeurs avant modification
  apres          Json?    // reçu : valeurs après modification
  donnees        Json?    // données structurées du résultat (identifiants créés…), relues par les objectifs
  agent          String?  // agent Axso qui a agi pour la connexion (business, store…), vide si l'IA externe agit seule
  approuvePar    String?  // userId de la personne qui a validé une action en attente d'accord
  coutEstime     Float    @default(0) // coût estimé de l'appel (FCFA), compté dans l'usage du mois
  annuleLe       DateTime?
  createdAt      DateTime @default(now())

  connexion ConnexionIA @relation(fields: [connexionId], references: [id], onDelete: Cascade)

  @@unique([connexionId, cleIdempotence])
  @@index([tenantId, createdAt])
}

// Tâche longue lancée par une IA (étude, génération, import, objectif) : l'appel
// MCP rend la main tout de suite, l'IA suit l'avancement (lib/controle-ia/taches.ts).
model TacheIA {
  id          String   @id @default(cuid())
  tenantId    String
  connexionId String?
  type        String
  statut      String   @default("en_attente") // en_attente | en_cours | termine | echec
  progression Int      @default(0) // 0 à 100
  etape       String?
  resultat    Json?
  erreur      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
}

// Plan d'un objectif business confié à une IA (lib/controle-ia/modules/objectifs.ts).
model PlanIA {
  id          String   @id @default(cuid())
  tenantId    String
  connexionId String
  objectif    String   @db.Text
  contraintes Json     @default("{}")
  etapes      Json     @default("[]") // [{ id, titre, outil, args, statut, resultat, actionId }]
  statut      String   @default("propose") // propose | en_cours | attente_accord | termine | echec | annule
  rapport     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
}

// Événements métier (order.created, inventory.low…) publiés par lib/controle-ia/evenements.ts.
model EvenementIA {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  donnees   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId, type, createdAt])
}

// Abonnement d'un service externe aux événements d'une boutique (appel signé HMAC).
model WebhookIA {
  id         String   @id @default(cuid())
  tenantId   String
  url        String
  evenements String[]
  secret     String
  actif      Boolean  @default(true)
  echecs     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// Automatisation créée par une IA : déclencheur (événement ou horaire), conditions,
// étapes (outils, attente, accord, branche). Elle agit avec les droits de sa connexion :
// connexion révoquée = automatisation à l'arrêt.
model AutomatisationIA {
  id                 String    @id @default(cuid())
  tenantId           String
  connexionId        String
  nom                String
  declencheur        Json      // { type: "evenement", evenement } | { type: "horaire", ... }
  conditions         Json      @default("[]")
  etapes             Json      @default("[]")
  actif              Boolean   @default(true)
  prochaineExecution DateTime?
  derniereExecution  DateTime?
  executions         Int       @default(0)
  dernierResultat    String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId])
  @@index([actif, prochaineExecution])
}

// Exécution en cours d'une automatisation (attente, accord, reprise après échec).
model ExecutionAutomatisation {
  id               String    @id @default(cuid())
  automatisationId String
  tenantId         String
  statut           String    @default("en_cours") // en_cours | en_attente | termine | echec
  etape            Int       @default(0)
  contexte         Json      @default("{}")
  journal          Json      @default("[]")
  reprendreLe      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([automatisationId])
  @@index([statut, reprendreLe])
}

// Médiathèque : tout média généré ou importé par une IA, indexé et réutilisable.
model MediaIA {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   // image | video | audio
  fournisseur String   // moteur qui l'a produit (gemini, higgsfield, import…)
  url         String
  cleStockage String?
  metadonnees Json     @default("{}")
  largeur     Int?
  hauteur     Int?
  duree       Float?
  creePar     String   // connexionId ou userId
  usage       Json     @default("{}") // { produits: [], campagnes: [], pages: [] }
  createdAt   DateTime @default(now())

  @@index([tenantId, type, createdAt])
}

// =====================
// AXSO BUILDER MCP (lib/builder) — la vitrine en ligne reste Tenant.themeConfig ;
// une IA ne modifie que le BROUILLON, publié ensuite selon la politique.
// =====================
model BrouillonBoutique {
  tenantId      String   @id
  config        Json     // themeConfig complet en cours de préparation
  baseEmpreinte String   // empreinte de la version en ligne au départ du brouillon (conflit si elle a changé)
  majPar        String   // connexionId ou userId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Version de la boutique : chaque publication, instantané ou restauration en crée une.
model VersionBoutique {
  id          String   @id @default(cuid())
  tenantId    String
  numero      Int
  type        String   // publication | instantane | avant_restauration
  config      Json
  auteur      String   // userId
  client      String?  // IA qui l'a faite (« Claude »…), vide pour le marchand
  fournisseur String?
  connexionId String?
  raison      String   @db.Text
  changements Json     @default("[]") // résumé du diff avec la version précédente
  createdAt   DateTime @default(now())

  @@unique([tenantId, numero])
  @@index([tenantId, createdAt])
}

// Test A/B d'une variante de l'accueil (lib/builder/experiences.ts).
model ExperienceBoutique {
  id         String    @id @default(cuid())
  tenantId   String
  nom        String
  statut     String    @default("brouillon") // brouillon | en_cours | arrete
  variantes  Json      // [{ id, nom, config (partielle : builderTree, sections…) }]
  repartition Int      @default(50) // % de visiteurs sur la variante B
  metrique   String    @default("conversion")
  resultats  Json      @default("{}")
  debut      DateTime?
  fin        DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId, statut])
}

// =====================
// COMMERCE OS — usage mesuré par boutique et par mois (lib/controle-ia/usage.ts) :
// appels MCP, exécutions d'outils, workflows d'agents, contenus et images générés,
// recherches fournisseurs, automatisations. Sert aux limites du plan et à la facturation à l'usage.
// =====================
model UsageIA {
  id        String   @id @default(cuid())
  tenantId  String
  periode   String   // AAAA-MM
  type      String   // mcp_call | tool_execution | agent_workflow | generated_content | generated_image | generated_video | supplier_search | automation_run | ai_call
  nombre    Int      @default(0)
  cout      Float    @default(0) // FCFA estimés
  updatedAt DateTime @updatedAt

  @@unique([tenantId, periode, type])
}

// Agent installé sur une boutique (préparation de la place de marché d'agents) : les agents
// Axso sont décrits dans le code (lib/agents-os) ; un agent tiers aura ici son manifeste.
model AgentManifeste {
  id          String   @id @default(cuid())
  tenantId    String?  // vide : agent proposé à toutes les boutiques
  agentId     String
  nom         String
  description String   @db.Text
  version     String   @default("1.0.0")
  developpeur String   @default("Axso")
  permissions String[]
  outils      String[]
  tarif       Json     @default("{}")
  statut      String   @default("brouillon") // brouillon | publie | suspendu
  actif       Boolean  @default(true)        // activé par le marchand
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, agentId])
}

}

// =====================
// RÈGLE DE PORT (Moteur livraison)
// =====================
model ReglePort {
  id           String   @id @default(cuid())
  tenantId     String
  nom          String
  pays         String[] @default([])  // codes ISO2 desservis ; vide = tous les pays
  zone         String   @default("")  // quartier/ville précis dans ces pays ; vide = tout le pays
  poidsMin     Float    @default(0)   // kg
  poidsMax     Float?                 // null = illimité
  montantMin   Float?                 // montant commande min pour activer
  montantMax   Float?
  frais        Float                  // frais fixes
  fraisKg      Float    @default(0)  // par kg supplémentaire (hors périmètre actuel, inerte)
  delai        String   @default("3-5 jours")
  transporteur String?  // Campost | DHL | MTN Delivery | Sendbox | nom d'agence de voyage | ...
  modeLivraison String  @default("livreur_local") // livreur_local | agence_voyage | transporteur_intl
  gratuit      Boolean  @default(false)
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, actif])
}

// =====================
// FOURNISSEUR DROPSHIPPING
// =====================
model Fournisseur {
  id             String   @id @default(cuid())
  tenantId       String
  nom            String
  pays           String   @default("Chine")
  type           String   @default("aliexpress") // aliexpress | cj | jumia | local | autre
  url            String?
  email          String?
  telephone      String?
  delaiLivraison Int?     // jours annoncés par le fournisseur ; vide tant que personne ne l'a saisi
  fiabilite      Float?   // 1–5 ; vide tant que non évaluée (plus de note 4/5 inventée)
  margeAuto      Float    @default(0.30) // marge par défaut 30%
  actif          Boolean  @default(true)
  catalogueCount Int      @default(0)
  livraisonsTotal Int     @default(0)
  livraisonsOk   Int      @default(0)
  notes          String?
  // ── Supplier Intelligence : informations DÉCLARÉES (saisies par le marchand,
  // importées ou extraites par l'IA d'un texte fourni). Le niveau de confiance
  // de chaque champ vit dans VerificationFournisseur (dernière ligne du champ) :
  // sans ligne « verifie », la donnée reste « déclarée par le fournisseur ».
  typeEntreprise      String   @default("inconnu") // fabricant | fabricant_trading | trading | grossiste | distributeur | inconnu
  anneeCreation       Int?
  nbEmployes          Int?
  capaciteProduction  String?  // texte libre, ex. « 50 000 unités / mois »
  adresseUsine        String?
  categoriesProduites String[] @default([])
  marchesExport       String[] @default([]) // pays ou régions d'exportation déclarés
  photosUsine         String[] @default([])
  videoUsine          String?
  equipements         String?
  numeroLicence       String?
  protectionPaiement  String?  // ex. « Trade Assurance » — déclaré, jamais garanti par AXSO
  personnalisation    Boolean? // null = inconnu
  privateLabel        Boolean?
  packagingPerso      Boolean?
  echantillonPossible Boolean? // false = refus d'échantillon (signal de risque)
  inspectionAcceptee  Boolean? // false = refus d'inspection (signal de risque)
  paiementHorsPlateforme Boolean @default(false) // le marchand signale une pression pour payer hors plateforme
  // Cache de la dernière analyse (recalculé par lib/sourcing/fournisseurs/service.ts)
  scoreGlobal     Int?
  scoreFabricant  Int?
  niveauRisque    String?  // faible | moyen | eleve
  labelVerifie    Boolean  @default(false) // « AXSO Verified Supplier » : calculé, jamais saisi
  signatureRisque String?  // signaux actifs à la dernière surveillance (anti-doublon des alertes)
  analyseLe       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  produits             Produit[]
  commandesFournisseur CommandeFournisseur[]
  offres               ProduitFournisseur[]
  documents            DocumentFournisseur[]
  audits               AuditFournisseur[]
  echantillons         EchantillonFournisseur[]
  evaluations          EvaluationFournisseur[]
  verifications        VerificationFournisseur[]
  reponsesDevis        ReponseDevis[]

  bonsCommande BonCommande[] // POS 2.0

  @@index([tenantId, actif])
}

// =====================
// RETOUR / RMA
// =====================
model RetourRMA {
  id          String   @id @default(cuid())
  tenantId    String
  commandeId  String
  clientNom   String
  clientEmail String?  // facultatif : une commande payée à la livraison n'a pas toujours d'email
  raison      String   // defaut | erreur_commande | change_avis | endommage | non_recu
  description String?
  type        String   @default("remboursement") // remboursement | echange | avoir
  statut      String   @default("ouvert")        // ouvert | en_cours | accepte | rejete | clos
